C {devices/code_shown.sym} 1290 -540 0 0 {name=NGSPICE
only_toplevel=true
value="
* ngspice commands
.option wnflag=1 
.option savecurrents
.control
save all
dc VDD 1.65 3.3 0.825
** remove zero length vectors to prevent write errors
remzerovec
write ~/.xschem/simulations/parallel_bandgap_dc_sweep.raw 
wrdata ~/.xschem/simulations/parallel_bandgap_dc_sweep.txt V(VREF) I(V0) I(V1)
set appendwrite
plot V(VREF)
op
remzerovec
write ~/.xschem/simulations/parallel_bandgap_dc_sweep.raw
.endc
"

}
