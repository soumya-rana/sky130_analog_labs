only_toplevel=true
value="
* ngspice commands
.option wnflag=1 
.option savecurrents
.control
save all
dc temp -40 125 5
** remove zero length vectors to prevent write errors
remzerovec
write ~/.xschem/simulations/parallel_bandgap_dc_sweep.raw 
wrdata ~/.xschem/simulations/parallel_bandgap_dc_sweep.txt V(VREF) V(VUPB)
set appendwrite
plot V(VREF)
op
remzerovec
write ~/.xschem/simulations/parallel_bandgap_dc_sweep.raw
.endc
"

}
